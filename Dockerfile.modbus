FROM python:3.12-slim

LABEL org.opencontainers.image.title="GridSight Modbus Service"
LABEL org.opencontainers.image.description="Čte data z Cerbo GX přes Modbus TCP a ukládá do SQLite"

WORKDIR /app

COPY modbus/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY modbus/modbus_poll.py .

ENV DATA_DIR=/data

CMD ["python", "-u", "modbus_poll.py"]
