{
    "name": "hacesoft/gridsight",
    "description": "GridSight – vizualizace energetické bilance FVE",
    "type": "project",
    "license": "GPL-3.0",
    "require": {
        "php": ">=8.2",
        "phpoffice/phpspreadsheet": "^2.3"
    },
    "autoload": {
        "files": [
            "src/DB.php",
            "src/Parser.php",
            "src/Finance.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
