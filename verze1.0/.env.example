# ═══════════════════════════════════════════════════════════════
#  GridSight · konfigurace
#  cp .env.example .env  →  uprav  →  docker compose up -d
# ═══════════════════════════════════════════════════════════════

# Port aplikace v prohlížeči: http://<IP_NASU>:${APP_PORT}
APP_PORT=5080

# Složka pro SQLite DB + XLSX soubory (absolutní cesta na NASu)
# Synology: /volume1/docker/gridsight/data
DATA_PATH=./data

# Timezone
TZ=Europe/Prague

# ── Cerbo GX se nastavuje přes web UI (Settings stránka) ────────
# IP adresa, Unit ID a tarify se uloží do SQLite settings tabulky.
# Není potřeba je nastavovat zde.
